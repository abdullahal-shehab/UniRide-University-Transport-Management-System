{
  "name": "uniride",
  "version": "1.0.0",
  "description": "University Transport Management System - UniRide",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npx serve . -p 3000",
    "dev:desktop": "cd desktop && npm start",
    "build:desktop": "cd desktop && npm run build",
    "build:android": "cd android && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../desktop && npm install",
    "test": "cd backend && npm test",
    "lint": "cd backend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "uniride",
    "transport",
    "university",
    "management",
    "system"
  ],
  "author": "UniRide Team",
  "license": "MIT"
}